    "<ipv6><address><dhcp><rapid-commit/></dhcp></address></ipv6>"
)

# CLI: ipv6 address prefix-name <name> prefix-options ipv6-prefix <prefix>
IP6_ADDRESS_PREFIX_NAME_1715 = (
